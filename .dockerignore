# Dependencies — reinstalled inside the image; excluding avoids stale local modules in the build context
node_modules

# Build output — produced during `npm run build` in the Dockerfile
dist

# Lambda packaging artifact — not used by the containerized Cart Service
.lambda-package

# AWS CDK infrastructure code — not required to run the Cart Service
cdk

# Tests — not needed in the production image; excluding speeds up context upload
test
**/*.spec.ts
coverage

# Git metadata — not used at runtime
.git
.gitignore

# Local environment and secrets — must not be baked into the image
.env
.env.*
env.example

# Documentation and editor config — not needed to build or run the service
README.md
*.md
.editorconfig
.prettierrc
.eslintrc.js

# Shell helpers and deploy scripts — not part of the container runtime
get-token.sh
scripts

# Database init SQL — schema is applied separately (e.g. RDS), not at container start
db
