APP_PORT=4000

### Auth script credentials
AUTH_USERNAME=yourGithubLogin
AUTH_PASSWORD=TEST_PASSWORD
APP_URL=http://localhost:4000

# PostgreSQL (RDS) — used locally and on Lambda deploy (CDK reads this .env)
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_rds_password
DB_NAME=postgres
DB_SSL=true
